# Chế độ ModSecurity: DetectionOnly (chỉ phát hiện + ghi log) | On (chặn) | Off
WAF_MODE=DetectionOnly
# OWASP CRS Paranoia Level dùng để chặn (1-4). Bắt đầu với 1 để hạn chế false positive
PARANOIA=1
# Paranoia level dùng để phát hiện/ghi log (>= PARANOIA). Đặt cao hơn để "thử" PL mới mà không chặn
DETECTION_PARANOIA=1
# Ngưỡng anomaly score: request có tổng điểm >= ngưỡng sẽ bị chặn (khi WAF_MODE=On)
ANOMALY_INBOUND=5
ANOMALY_OUTBOUND=4
# Cổng WAF trên máy host (chỉ bind 127.0.0.1)
WAF_PORT=8080
